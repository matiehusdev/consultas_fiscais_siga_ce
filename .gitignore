# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest & Cobertura
.pytest_cache/
.coverage
htmlcov/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Variáveis de ambiente sensíveis
.env

# Dados dinâmicos, bancos de dados e arquivos confidenciais de clientes
data/*
!data/.gitkeep
!data/certificados/.gitkeep
!data/consultas/.gitkeep
!data/db/.gitkeep
!data/empresas/.gitkeep

# Proteção estrita: Certificados digitais e chaves NUNCA sobem para o GitHub
*.secret_key
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.jks
*.p7b
*.p7c
data/certificados/*
!data/certificados/.gitkeep

# Bancos de dados locais
*.db
*.sqlite
*.sqlite3
data/db/*
!data/db/.gitkeep

# Relatórios baixados e gerados de clientes
data/consultas/*
!data/consultas/.gitkeep

# Scripts de teste e rascunho temporários
scratch/

# Logs do sistema
*.log
logs/

# Arquivos de sistema e editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# PyInstaller & Executáveis compilados
build/
dist/
*.spec
*.exe
!Giro Empresarial.exe

