# Configurações do Sistema SIGA Fiscal
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Diretórios de Dados e Relatórios
DATA_DIR=data
DATABASE_PATH=data/db/siga_fiscal.db
CONSULTAS_DIR=data/consultas
EMPRESAS_DIR=data/empresas

# Automação SIGA / Navegador
BROWSER_HEADLESS=false
BROWSER_SLOW_MO_MS=100
CERTIFICATE_SELECTION_TIMEOUT_SECONDS=120
POLLING_INTERVAL_SECONDS=5
MAX_POLLING_ATTEMPTS=60
PAGE_TIMEOUT_MS=60000

# URL Base do SIGA SEFAZ-CE
SIGA_BASE_URL=https://siga.sefaz.ce.gov.br
